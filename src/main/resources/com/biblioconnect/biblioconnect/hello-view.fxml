<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="874.0" prefWidth="402.0" style="-fx-background-color: #ffffff;"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.biblioconnect.biblioconnect.HelloController">
    <children>
        <ImageView fitHeight="76.0" fitWidth="79.0" layoutX="21.0" layoutY="50.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@logo.png" />
            </image>
        </ImageView>

        <Label layoutX="100.0" layoutY="56.0" prefHeight="65.0" prefWidth="279.0" text="BiblioConnect" textFill="#120a59">
            <font>
                <Font name="System Bold" size="32.0" />
            </font>
        </Label>

        <Label alignment="TOP_CENTER" layoutX="49.0" layoutY="141.0" prefHeight="180.0" prefWidth="310.0"
               text="Gestión inteligente de préstamos y catálogo digital en un solo lugar"
               textAlignment="CENTER" textFill="#1e1e1e" wrapText="true">
            <font>
                <Font size="22.0" />
            </font>
        </Label>

        <ImageView fitHeight="310.0" fitWidth="345.0" layoutX="21.0" layoutY="333.0" pickOnBounds="true" preserveRatio="true">
            <image>
                <Image url="@illustration.png" />
            </image>
        </ImageView>

        <Button fx:id="btnIngresar" layoutX="16.0" layoutY="658.0" mnemonicParsing="false"
                onAction="#onIngresarClick" prefHeight="76.0" prefWidth="370.0"
                style="-fx-background-color: #120a59; -fx-background-radius: 20; -fx-cursor: hand;"
                text="Ingresar al Sistema" textFill="WHITE">
            <font>
                <Font size="22.0" />
            </font>
        </Button>

        <Button fx:id="btnConsultar" layoutX="16.0" layoutY="752.0" mnemonicParsing="false"
                onAction="#onConsultarClick" prefHeight="76.0" prefWidth="370.0"
                style="-fx-background-color: #ffffff; -fx-border-color: #120a59; -fx-border-width: 5; -fx-border-radius: 20; -fx-background-radius: 20; -fx-cursor: hand;"
                text="Consultar Catálogo" textFill="#120a59">
            <font>
                <Font size="22.0" />
            </font>
        </Button>
    </children>
</AnchorPane>