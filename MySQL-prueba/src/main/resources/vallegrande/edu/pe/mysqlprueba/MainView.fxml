<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="600.0" prefWidth="800.0" style="-fx-background-color: #1a1e29;" xmlns="http://javafx.com" xmlns:fx="http://javafx.com" fx:controller="vallegrande.edu.pe.mysqlprueba.controller.MainController">
    <children>
        <Text fill="WHITE" layoutX="30.0" layoutY="40.0" strokeType="OUTSIDE" strokeWidth="0.0" text="APARC - SISTEMA DE GESTIÓN DE PRODUCTORES DE UVA">
            <font>
                <Font name="System Bold" size="16.0" />
            </font>
        </Text>

        <!-- Formulario de Captura de Datos de Productores (Opción 1) -->
        <VBox layoutX="30.0" layoutY="60.0" prefWidth="740.0" spacing="10.0">
            <children>
                <HBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Nombre Completo del Productor:" textFill="WHITE" />
                                <TextField fx:id="txtNombre" promptText="Ej. Juan Castillo" style="-fx-background-color: #242936; -fx-text-fill: white;" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Documento Nacional de Identidad (DNI):" textFill="WHITE" />
                                <TextField fx:id="txtDni" promptText="Ej. 74859612" style="-fx-background-color: #242936; -fx-text-fill: white;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <HBox spacing="15.0">
                    <children>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Teléfono Celular:" textFill="WHITE" />
                                <TextField fx:id="txtTelefono" promptText="Ej. 987654321" style="-fx-background-color: #242936; -fx-text-fill: white;" />
                            </children>
                        </VBox>
                        <VBox spacing="5.0" HBox.hgrow="ALWAYS">
                            <children>
                                <Label text="Comunidad / Distrito:" textFill="WHITE" />
                                <TextField fx:id="txtComunidad" promptText="Ej. Imperial" style="-fx-background-color: #242936; -fx-text-fill: white;" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Barra de Botones de Operaciones CRUD Completo -->
                <HBox spacing="10.0" prefWidth="740.0">
                    <children>
                        <Button fx:id="btnRegistrar" mnemonicParsing="false" onAction="#onRegistrarAction" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: #007bff; -fx-text-fill: white; -fx-font-weight: bold;" text="[ REGISTRAR ]" />
                        <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#onActualizarAction" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: #17a2b8; -fx-text-fill: white; -fx-font-weight: bold;" text="[ ACTUALIZAR ]" />
                        <Button fx:id="btnEliminar" mnemonicParsing="false" onAction="#onEliminarAction" HBox.hgrow="ALWAYS" maxWidth="Infinity" style="-fx-background-color: #dc3545; -fx-text-fill: white; -fx-font-weight: bold;" text="[ ELIMINAR ]" />
                    </children>
                </HBox>
            </children>
        </VBox>

        <!-- Tabla de Visualización de Productores -->
        <TableView fx:id="tableCitas" layoutX="30.0" layoutY="240.0" prefHeight="330.0" prefWidth="740.0" style="-fx-background-color: #242936;">
            <columns>
                <TableColumn fx:id="colId" prefWidth="60.0" text="ID" />
                <TableColumn fx:id="colNombre" prefWidth="220.0" text="Nombre del Productor" />
                <TableColumn fx:id="colDni" prefWidth="120.0" text="DNI" />
                <TableColumn fx:id="colTelefono" prefWidth="130.0" text="Teléfono" />
                <TableColumn fx:id="colComunidad" prefWidth="208.0" text="Comunidad" />
            </columns>
        </TableView>
    </children>
</AnchorPane>
